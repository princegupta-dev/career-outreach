{
  "name": "@job-hunter/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "fetch": "ts-node --transpile-only src/fetch.ts",
    "test": "jest --config jest.config.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "login": "ts-node --transpile-only src/login.ts",
    "apply": "ts-node --transpile-only src/apply.ts",
    "answers": "ts-node --transpile-only src/answers.ts",
    "daily": "ts-node --transpile-only src/daily.ts"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "playwright": "^1.64.1",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "eslint": "^9.30.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
