# All optional. Defaults work out of the box.
API_PORT=4000
# Where your profile lives (default: candidate/candidate-profile.md)
# CANDIDATE_PROFILE_PATH=/absolute/path/to/candidate-profile.md
# The web app proxies /api/* here
# API_INTERNAL_URL=http://localhost:4000

# Local outreach (optional; discovery works without Ollama)
# Export these in the terminal before npm start; this app does not auto-load .env.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_TIMEOUT_MS=120000
# JOB_HUNTER_OUTREACH_DIR=/absolute/path/to/private/outreach-cache
# UI-selected model settings (takes precedence over OLLAMA_MODEL)
# JOB_HUNTER_OLLAMA_SETTINGS=/absolute/path/to/private/ollama.json
# Optional override for the PDF uploaded through the Naukri panel
# JOB_HUNTER_NAUKRI_RESUME=/absolute/path/to/private/resume.pdf
# Shared PDF override for Naukri, Hirist, Instahyre and company applications
# JOB_HUNTER_APPLICATION_RESUME=/absolute/path/to/private/resume.pdf
